<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <PreferenceCategory
        app:iconSpaceReserved="false"
        app:key="category_recording"
        app:title="@string/settings_category_recording">

        <ListPreference
            app:defaultValue="standard"
            app:entries="@array/quality_entries"
            app:entryValues="@array/quality_values"
            app:iconSpaceReserved="false"
            app:key="quality_preset"
            app:title="@string/settings_quality"
            app:useSimpleSummaryProvider="true" />

        <ListPreference
            app:defaultValue="0"
            app:iconSpaceReserved="false"
            app:key="input_device"
            app:title="@string/settings_microphone"
            app:useSimpleSummaryProvider="true" />

        <SwitchPreferenceCompat
            app:defaultValue="false"
            app:iconSpaceReserved="false"
            app:key="stereo"
            app:summary="@string/settings_stereo_summary"
            app:title="@string/settings_stereo" />

        <SwitchPreferenceCompat
            app:defaultValue="false"
            app:iconSpaceReserved="false"
            app:key="clear_voice"
            app:summary="@string/settings_clear_voice_summary"
            app:title="@string/settings_clear_voice" />

        <SwitchPreferenceCompat
            app:defaultValue="false"
            app:iconSpaceReserved="false"
            app:key="tag_with_location"
            app:summary="@string/settings_location_message"
            app:title="@string/settings_location" />
    </PreferenceCategory>

    <PreferenceCategory
        app:iconSpaceReserved="false"
        app:title="@string/settings_category_transcription">

        <SwitchPreferenceCompat
            app:defaultValue="true"
            app:iconSpaceReserved="false"
            app:key="transcribe"
            app:summary="@string/settings_transcribe_summary"
            app:title="@string/settings_transcribe" />

        <Preference
            app:iconSpaceReserved="false"
            app:key="models"
            app:summary="@string/settings_models_summary"
            app:title="@string/settings_models">
            <intent
                android:targetClass="org.prauga.recorder.transcription.ModelsActivity"
                android:targetPackage="@string/application_id" />
        </Preference>

        <SwitchPreferenceCompat
            app:defaultValue="true"
            app:iconSpaceReserved="false"
            app:key="models_wifi_only"
            app:title="@string/settings_wifi_only" />
    </PreferenceCategory>

    <PreferenceCategory
        app:iconSpaceReserved="false"
        app:title="@string/settings_category_appearance">

        <ListPreference
            app:defaultValue="system"
            app:entries="@array/theme_entries"
            app:entryValues="@array/theme_values"
            app:iconSpaceReserved="false"
            app:key="theme"
            app:title="@string/settings_theme"
            app:useSimpleSummaryProvider="true" />
    </PreferenceCategory>

    <PreferenceCategory
        app:iconSpaceReserved="false"
        app:title="@string/settings_category_about">

        <Preference
            app:iconSpaceReserved="false"
            app:key="version"
            app:selectable="false"
            app:title="@string/settings_version" />
    </PreferenceCategory>
</PreferenceScreen>
